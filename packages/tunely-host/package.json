{
  "name": "dsh-plugin-tunely-host",
  "description": "Tunely public-tunnel host adapter for DeepSeek Harness: runs tunely TunnelClient clients in-process (no sidecar binary, no state files), N tunnels per process, default target is the local dsh web server",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "tunely": "^0.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.2",
    "ws": "^8.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffkit/dsh-lavs-integration.git"
  },
  "files": [
    "lib"
  ]
}
