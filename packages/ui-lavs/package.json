{
  "name": "dsh-plugin-ui-lavs",
  "description": "LAVS Views tab for DeepSeek Harness: a native right-Sidebar tab type whose body mounts LAVS view bundles in iframes, bridged to the lavs-host adapter over the Connection RPC",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffkit/dsh-lavs-integration.git"
  },
  "files": [
    "lib"
  ]
}
