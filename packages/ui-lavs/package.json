{
  "name": "dsh-plugin-ui-lavs",
  "description": "LAVS Views tab for DeepSeek Harness: one conversation.view tab mounting LAVS view bundles in an iframe, bridged to the lavs-host adapter over the Connection RPC",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/api/remotes",
    "@deepseek-ai/dsh-brand": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/util/brand",
    "@deepseek-ai/dsh-client-connection": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/client/store",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/client/ui-slots",
    "@deepseek-ai/dsh-invariants": "link:../../../deepseek-harness/.worktrees/rebase-rehearsal/packages/runtime-diagnostics/invariants",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.2"
  }
}
